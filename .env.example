# Set at least one API key below for UI analysis; the other may remain blank.
# Missing, empty, or whitespace-only keys disable that provider in the dropdown.
# With neither key, Analyze is disabled unless IMPACTMAP_MOCK=1.
# Restart Streamlit after editing .env; shell environment variables take precedence.
# AI_PROVIDER is preferred initially; the UI selects a configured provider if needed.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
IMPACTMAP_MOCK=0
# Optional for GitHub API requests (Git clone authentication is separate)
GITHUB_TOKEN=

